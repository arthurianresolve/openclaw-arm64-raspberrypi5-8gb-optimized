{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.mjs",
    "../knip.config.ts",
    "../tsdown.config.ts",
    "../vitest.config.ts",
    "../apps/android/scripts/**/*.ts",
    "../.pi/extensions/**/*.ts",
    "../src/types/**/*.d.ts",
    "../ui/src/ui/data/**/*.ts"
  ],
  "exclude": [
    "pre-commit/**",
    "e2e/*docker-client.ts",
    "e2e/mcp-channels-harness.ts",
    "e2e/pi-bundle-mcp-tools-docker-client.ts",
    "e2e/session-runtime-context-docker-client.ts"
  ]
}
